# 로컬 개발용 — 이 파일을 `.env`로 복사해서 쓴다. (`.env`는 gitignore됨)
#
# ⚠️ 운영 `.env`를 여기 복사하지 말 것. 이건 완전히 다른 파일이다.
#    운영 값(SECRET_KEY·DB_PASSWORD·SES 자격증명 등)은 EC2 `~/blog/.env`에만 있고,
#    사본은 `~/.blog-secrets/prod.env`와 SSM `/blog/prod/env`에 있다.
#    운영 템플릿이 궁금하면 `backend/.env.example`을 볼 것.
#
# 여기 넣을 건 **다섯 개**다. 나머지(DATABASE_URL·SECRET_KEY·SMTP 등)는
# `docker-compose.yml`의 environment 블록에 개발용 값으로 이미 박혀 있어서
# 이 파일에 안 써도 된다.
#
# ⚠️ 예전엔 이 자리가 "**딱 두 개**"라고 적혀 있었다. 실제로 compose가 치환하는 건
#    다섯이고 VAPID 3개가 빠져 있었다 — 안 넣으면 **푸시가 조용히 꺼진 채로** 앱이
#    정상 동작한다. README가 "실제로 닿는 건 푸시 쪽"이라 강조한 기능이 로컬에서
#    통째로 사라지는데, 누락이 아니라 **오정보**라서 읽은 사람이 더 찾지 않는다.
#    같은 병을 운영 템플릿(backend/.env.example)은 08-10 복원훈련에서 이미 고쳤는데
#    **로컬 템플릿만 안 쓸렸다.** (2026-08-11 동료 리뷰)
#
# 다섯 다 비워도 스택은 정상적으로 뜬다. 해당 기능만 꺼진다.
#
# 🔴 **돈 주의 — 여기 넣은 AI 키로 로컬 테스트가 진짜 청구를 낸다.**
#    `/api/ai/draft`는 목킹이 없다. 로컬에서 한 번 부르면 실제 벤더 호출이 나가고,
#    동시성·부하 테스트를 돌리면 그 배수로 나간다(2026-08-11 동적 분석에서 11건,
#    입력 26,180 / 출력 2,044 토큰을 실제로 썼다). 검증용으로 돌릴 때는
#    **키를 비우고** 503 경로를 보거나, 테스트에서 generate_draft를 목킹할 것.

# AI 초안 생성(Claude). 비우면 /api/ai/draft가 503으로 안내하고 나머지는 정상.
# ⚠️ 운영과 같은 키를 쓰지 말 것 — 따로 발급하면 사용량을 분리해 보고,
#    한쪽이 유출돼도 다른 쪽을 살린 채 폐기할 수 있다.
ANTHROPIC_API_KEY=

# BYOK(사용자가 맡긴 GPT/Gemini 키) 암호화용 Fernet 키. 비우면 BYOK 저장이 비활성.
# ⚠️ 반드시 운영과 다른 값으로. 로컬용은 아래로 새로 만들면 된다(무료):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_ENCRYPTION_KEY=

# Web Push(VAPID). 셋 다 비우면 푸시 기능이 통째로 꺼진다 — 엔드포인트는 503을 주고
# 발송은 무동작이며, **앱은 그대로 정상 기동한다**(그래서 빠뜨려도 안 티가 난다).
# 키 만들기(무료): python backend/scripts/gen_vapid_keys.py
# ⚠️ 운영과 다른 키를 쓸 것. 같은 키를 쓰면 로컬 테스트 구독이 운영 발송에 섞인다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 브라우저 푸시 서비스가 문제 시 연락할 주소. 비우면 compose가 기본값을 넣는다.
VAPID_SUBJECT=
